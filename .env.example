# Copy to .env and fill only the values you want to change.
# Priority: environment variables > .env > defaults in src/livraison_express/config.py.
# Never put secrets in this file: it is committed. .env is ignored by git.

# Where jobs read orders from (ADR-0013): memory (generated orders) | postgres (the ERP database).
ORDER_SOURCE=memory

# Required when ORDER_SOURCE=postgres, ignored otherwise. Holds a password: set it in .env or in
# the job's environment, never here. Use the read-only role, e.g.
# postgresql://ml_reader:<password>@erp-postgres:5432/livraison_express
POSTGRES_DSN=

# Folder holding one sub-folder per model version (model.joblib + metadata.json).
# Default: <project>/artifacts
ARTIFACTS_DIR=

# Version to train (must not exist yet) or to load for predictions.
MODEL_VERSION=2.0.0

# Probability from which an order is eligible (0 to 1).
DECISION_THRESHOLD=0.5

# Seed for data generation, train/test split and model.
RANDOM_STATE=42

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# MLflow experiment tracking (training only). Default: sqlite:///<project>/mlflow.db
MLFLOW_TRACKING_URI=

# Where MLflow stores run files (models, model card). Default: <project>/mlruns
MLFLOW_ARTIFACT_LOCATION=
