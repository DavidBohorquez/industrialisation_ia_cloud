# Copy to .env and fill only the values you want to change.
# Priority: environment variables > .env > defaults in src/livraison_express/config.py.
# Never put secrets in this file: it is committed. .env is ignored by git.

# Selects the implementations in src/livraison_express/factory.py. Only "dev" exists today.
APP_ENV=dev

# Folder holding one sub-folder per model version (model.joblib + metadata.json).
# Default: <project>/artifacts
ARTIFACTS_DIR=

# Version to train (must not exist yet) or to load for predictions.
MODEL_VERSION=1.0.0

# Probability from which an order is eligible (0 to 1).
DECISION_THRESHOLD=0.5

# Seed for data generation, train/test split and model.
RANDOM_STATE=42

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
