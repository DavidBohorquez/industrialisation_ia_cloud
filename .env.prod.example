# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored), fill in.

# Released application version (ghcr.io image tag, see CHANGELOG.md).
APP_VERSION=2.0.0
# Model version the API serves, and the default version `train` writes.
MODEL_VERSION=2.0.0
# Read replica, read-only role (ADR-0009). Given by the database administrator: a secret.
POSTGRES_DSN=postgresql://ml_reader:CHANGE_ME@replica.db.internal:5432/livraison_express
DECISION_THRESHOLD=0.5
LOG_LEVEL=INFO
API_PORT=8000
