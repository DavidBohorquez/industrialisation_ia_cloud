# Copy to .env before the first `docker compose up` (cp .env.example .env): the official
# docker-compose.yaml requires a .env file. .env is ignored by git; never commit real passwords.
# Compose reads it for the ${...} values and also passes every key to the Airflow containers.

# ---------- Airflow (variables of the official file) ----------

# User id of the Airflow processes. Linux: the output of `id -u`, so that the files written in
# logs/ and config/ belong to you. Docker Desktop (macOS, Windows): keep 50000.
AIRFLOW_UID=50000

# Administrator account created by airflow-init (login at http://127.0.0.1:8080).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Encrypts the connections and variables stored in Airflow's database. Empty: stored in clear
# (acceptable locally: the ERP connection comes from the environment, not from the database).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------- livraison-express additions ----------

# Linux only: group id of the Docker socket, so that the worker may start the training
# container: stat -c %g /var/run/docker.sock. Docker Desktop: leave empty.
DOCKER_GID=

# Password of the read-only role ml_reader on the ERP database (test value of the test stack).
# Becomes the Airflow connection erp_postgres; URL-encode special characters (@ : / ...).
ML_READER_PASSWORD=ml_reader

# Image run by the DAG, from the host's Docker engine. Built at the repository root with
# `docker compose -f docker-compose.test.yml build train`, or a published one
# (ghcr.io/davidbohorquez/industrialisation_ia_cloud-train:X.Y.Z).
TRAIN_IMAGE=livraison-express-train:local

# When the DAG checks the ERP database (cron, UTC). The simulator writes about one order per
# second, so a check every 10 minutes sees a few hundred new labels.
RETRAIN_SCHEDULE="*/10 * * * *"

# New labelled orders (since the last successful training) needed to train a new model.
MIN_NEW_LABELLED_ORDERS=1000

# Trained versions are named <prefix>+<UTC date and time of the run>, e.g. 2.0.0+20261120T101500
# (SemVer build metadata: same model recipe, newer data). Must be X.Y.Z.
MODEL_VERSION_PREFIX=2.0.0

# Docker volumes the training writes to: the models volume read by the API, and MLflow's runs.
# Default: those of docker-compose.test.yml (Compose project "livraison-express-test").
MODELS_VOLUME=livraison-express-test_models
MLRUNS_VOLUME=livraison-express-test_mlruns
